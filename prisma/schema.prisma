generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "cockroachdb"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  name          String
  passwordHash  String
  createdAt     DateTime @default(now())
  trialEndsAt   DateTime
  subscriptionStatus String @default("TRIAL")
  stripeCustomerId   String?
  stripeSubscriptionId String?

  strategies     Strategy[]
  simulations    Simulation[]
  liveApplyRuns  LiveApplyRun[]
  paperPositions PaperPosition[]
}

model Strategy {
  id          String   @id @default(cuid())
  userId      String
  name        String
  description String?
  platform    String
  config      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  isActive    Boolean  @default(true)

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  simulations    Simulation[]
  liveApplyRuns  LiveApplyRun[]
  paperPositions PaperPosition[]
}

model Simulation {
  id          String   @id @default(cuid())
  userId      String
  strategyId  String
  name        String
  status      String   @default("PENDING")
  startDate   DateTime
  endDate     DateTime
  initialCapital Float  @default(1000)
  platform    String

  metricsJson String?
  tradesJson  String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  strategy    Strategy @relation(fields: [strategyId], references: [id], onDelete: Cascade)
}

model LiveApplyRun {
  id             String   @id @default(cuid())
  userId         String
  strategyId     String
  paramsJson     String
  marketsScanned Int
  matchCount     Int
  matchesJson    String
  createdAt      DateTime @default(now())

  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  strategy       Strategy @relation(fields: [strategyId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@index([strategyId])
}

/// Paper-traded positions for a strategy. Live cron enters new positions when
/// a market matches the strategy's filter; closes them at maxHoldingDays via
/// a separate exit cron. Used to validate sim-live ≡ dryrun parity (T-0002)
/// before any real money. Does not place real Polymarket orders — that's T-0014.
model PaperPosition {
  id              String   @id @default(cuid())
  userId          String
  strategyId      String

  marketSlug      String
  marketQuestion  String
  side            String   // "YES" | "NO"
  tokenId         String   // CLOB token id we'd buy
  endDate         DateTime // Market resolution date

  entryTime       DateTime
  entryMid        Float    // Mid YES price at entry (we pay 1-yesMid for NO)
  entryFillPrice  Float    // Slippage-adjusted price actually "paid"
  positionSizeUsd Float
  shares          Float    // sizeUsd / entryFillPrice

  status          String   @default("OPEN") // "OPEN" | "CLOSED" | "RESOLVED"
  exitTime        DateTime?
  exitMid         Float?
  exitFillPrice   Float?
  exitReason      String?  // "max_holding" | "resolution" | "tp" | "sl" | "manual"
  pnlUsd          Float?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  strategy        Strategy @relation(fields: [strategyId], references: [id], onDelete: Cascade)

  // One open position per strategy per market (prevents the cron re-entering
  // a market that already has an open paper position).
  @@unique([strategyId, marketSlug, status])
  @@index([userId, status])
  @@index([status, entryTime])
}

model PolymarketMarket {
  slug                String   @id
  question            String
  conditionId         String

  outcomesJson        Json
  clobTokenIdsJson    Json

  closed              Boolean  @default(false)
  active              Boolean  @default(false)
  negRisk             Boolean  @default(false)

  startDate           DateTime?
  endDate             DateTime?

  liquidityNum        Float?
  volumeNum           Float?

  winningOutcomeIndex Int?

  lastSyncedAt        DateTime?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  candles             PolymarketPriceCandle[]

  @@index([closed])
  @@index([endDate])
  @@index([active])
}

model PolymarketPriceCandle {
  marketSlug String
  timestamp  DateTime
  yesPrice   Float

  market     PolymarketMarket @relation(fields: [marketSlug], references: [slug], onDelete: Cascade)

  @@id([marketSlug, timestamp])
}

model DataSyncLog {
  id            String   @id @default(cuid())
  startedAt     DateTime @default(now())
  finishedAt    DateTime?

  marketsAdded  Int      @default(0)
  marketsUpdated Int     @default(0)
  candlesAdded  Int      @default(0)

  status        String
  errorMessage  String?
  syncType      String
}
