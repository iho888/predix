# Database — local SQLite (default in .env for `npm run dev`):
#   DATABASE_URL="file:./prisma/dev.db"
# Production: PostgreSQL (set `provider = "postgresql"` in prisma/schema.prisma)
#   DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
DATABASE_URL="file:./prisma/dev.db"

# Auth
JWT_SECRET="your-random-secret-min-32-chars"

# Stripe (get from dashboard.stripe.com)
STRIPE_SECRET_KEY="sk_live_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
STRIPE_PRICE_ID="price_..."

# App
NEXT_PUBLIC_APP_URL="https://your-app.vercel.app"
TRIAL_DAYS="14"

# Live apply (Polymarket Gamma — server-side only; not exposed to the client)
GAMMA_BASE_URL="https://gamma-api.polymarket.com"
# Max markets to pull when scanning (pagination cap)
LIVE_APPLY_MAX_MARKETS="8000"
GAMMA_PAGE_LIMIT="100"
