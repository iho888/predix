# Database — local SQLite (default in .env for `npm run dev`):
#   DATABASE_URL="file:./prisma/dev.db"
# Production: PostgreSQL or CockroachDB (match `provider` in prisma/schema.prisma)
#   DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
DATABASE_URL="file:./prisma/dev.db"

# Optional: explicit CockroachDB Cloud URL used by scripts/strategy-optimizer.cjs
# and scripts/crdb-migrate.cjs. Falls back to DATABASE_URL if unset.
# CRDB_URL="postgresql://user:password@<crdb-host>.cockroachlabs.cloud:26257/defaultdb?sslmode=verify-full"

# Optional: legacy Neon URL, only needed by scripts/crdb-migrate.cjs (one-shot
# migration source). Leave unset unless you're re-running that migration.
# NEON_LEGACY_URL="postgresql://user:password@<host>.neon.tech/neondb?sslmode=require"

# Auth
JWT_SECRET="your-random-secret-min-32-chars"

# Stripe (get from dashboard.stripe.com)
STRIPE_SECRET_KEY="sk_live_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
STRIPE_PRICE_ID="price_..."

# App
NEXT_PUBLIC_APP_URL="https://your-app.vercel.app"
TRIAL_DAYS="14"

# Polymarket (server-side only; not exposed to the client)
GAMMA_BASE_URL="https://gamma-api.polymarket.com"
CLOB_BASE_URL="https://clob.polymarket.com"

# Polymarket DB sync / simulation
CRON_SECRET="your-random-secret-min-32-chars"
CANDLE_FIDELITY_MINUTES="60"
MAX_MARKETS_INITIAL_INGEST="100000"
SYNC_DELAY_MS="200"
# Cap on markets discovered per cron run (Phase 0 in runDailySync). Higher
# values find new markets faster but lengthen each cron invocation. See B-0005.
SYNC_DISCOVER_MAX="1500"

# Live apply (Gamma scan)
# Max markets to pull when scanning (pagination cap)
LIVE_APPLY_MAX_MARKETS="8000"
GAMMA_PAGE_LIMIT="100"
